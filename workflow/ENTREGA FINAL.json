    {
      "parameters": {
        "jsCode": "// Lee la respuesta del modelo (formato Chat Completions o Responses API) y valida el JSON\nconst res = $input.first().json;\n\nlet raw =\n  res.choices?.[0]?.message?.content ??\n  res.output_text ??\n  res.output?.find?.(o => o.type === 'message')?.content?.find?.(c => c.type === 'output_text')?.text ??\n  res.message?.content ??\n  res.content?.[0]?.text ??\n  res.text ??\n  null;\n\nif (raw && typeof raw === 'object') raw = JSON.stringify(raw);\nif (!raw) throw new Error('El modelo no devolvió contenido. Respuesta: ' + JSON.stringify(res).slice(0, 300));\n\n// Si el modelo envolvió el JSON en ```json ... ```, extraemos solo el objeto\nconst match = String(raw).match(/\\{[\\s\\S]*\\}/);\nlet ia;\ntry {\n  ia = JSON.parse(match ? match[0] : raw);\n} catch (e) {\n  throw new Error('La IA no devolvió un JSON válido: ' + String(raw).slice(0, 200));\n}\nif (!ia.respuesta_sugerida) throw new Error('La IA no generó respuesta_sugerida');\n\nconst TIPOS = ['Auto', 'Hogar', 'Comercio', 'Vida', 'Otro'];\nconst PRIORIDADES = ['Alta', 'Media', 'Baja'];\nconst faltantes = Array.isArray(ia.datos_faltantes) ? ia.datos_faltantes : [];\nconst u = res.usage || {};\n\nreturn [{\n  json: {\n    tipo: TIPOS.includes(ia.tipo_seguro) ? ia.tipo_seguro : 'Otro',\n    prioridad: PRIORIDADES.includes(ia.prioridad) ? ia.prioridad : 'Media',\n    motivo: ia.motivo_prioridad || '',\n    datosExtraidos: JSON.stringify(ia.datos_extraidos || {}, null, 2),\n    datosFaltantes: faltantes.length ? faltantes.map(x => '- ' + x).join('\\n') : 'Ninguno',\n    respuesta: ia.respuesta_sugerida,\n    tokens: u.total_tokens ?? ((u.input_tokens || 0) + (u.output_tokens || 0)),\n  },\n}];"
      },
