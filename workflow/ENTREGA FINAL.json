    {
      "parameters": {
        "jsCode": "// Normaliza y valida los datos del formulario\nconst f = $('Formulario de cotización').first().json;\nconst nombre = String(f.Nombre || '').trim();\nconst email = String(f.Email || '').trim().toLowerCase();\nconst telefono = String(f.Telefono || '').trim();\nconst mensaje = String(f.Mensaje || '').trim();\n\nconst errores = [];\nif (!nombre) errores.push('Falta el nombre');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errores.push('Email inválido');\nif (mensaje.length < 15) errores.push('Mensaje demasiado corto para cotizar (menos de 15 caracteres)');\n\nreturn [{ json: { valido: errores.length === 0, errores: errores.join('; '), nombre, email, telefono, mensaje } }];"
      },
